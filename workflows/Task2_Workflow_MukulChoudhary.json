    },
    {
      "id": "01bd125a-d3e6-4a02-a591-e45fcef138f4",
      "name": "Verify notification delivery",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;if(r.error) throw new Error('SMTP delivery failed: '+JSON.stringify(r.error));return [{json:{delivery:'accepted-by-smtp',messageId:r.messageId??null,accepted:r.accepted??[],response:r.response??null}}];"
      }
    }
