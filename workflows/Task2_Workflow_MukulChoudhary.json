    {
      "id": "799a2afc-a244-4a88-9581-215e4c4b12ec",
      "name": "Get public posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -240,
        0
      ],
      "parameters": {
        "url": "={{ $json.baseUrl + '/posts' }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "dc8fca05-c180-4677-ba68-789c8e41aa92",
      "name": "Keep top five",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json;\nif (r.error || r.statusCode!==200 || !Array.isArray(r.body)) return [{json:{ok:false,error:'Posts API unavailable or invalid response',statusCode:r.statusCode??null}}];\nconst posts=r.body.filter(p=>Number.isInteger(p.id)&&typeof p.title==='string').sort((a,b)=>b.id-a.id).slice(0,5).map(p=>({id:p.id,title:p.title}));\nif(!posts.length) return [{json:{ok:false,error:'No usable posts returned'}}];\nreturn [{json:{ok:true,posts,topPostId:posts[0].id}}];"
      }
    },
    {
      "id": "0be7488f-9a9a-4789-92d5-7b644ca959cc",
      "name": "Source is usable",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "702ee88f-805f-4f3c-b025-cf2329e76a63",
              "leftValue": "={{ $json.ok === true }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "40058f4f-4638-4d51-b801-83cc2cca556d",
      "name": "Get top post comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        -100
      ],
      "parameters": {
        "url": "={{ $('Settings').first().json.baseUrl + '/posts/' + $json.topPostId + '/comments' }}",
        "options": {
          "timeout": 10000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "c480ff5c-f392-417d-8e45-df3dad411730",
      "name": "Build enriched digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        -100
      ],
      "parameters": {
        "jsCode": "const r=$input.first().json, source=$('Keep top five').first().json;\nconst enriched=!r.error && r.statusCode===200 && Array.isArray(r.body);\nconst comments=enriched?r.body.filter(c=>typeof c.body==='string'):[];\nreturn [{json:{posts:source.posts,commentCount:comments.length,enrichmentOk:enriched,generatedAt:new Date().toISOString(),warning:enriched?'':'Comments unavailable: digest contains posts only.'}}];"
      }
    },
    {
      "id": "74602c05-20de-419e-8ec4-11e2b5b2d9b0",
      "name": "At least five comments",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        -100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "3aaa99c6-531f-4609-8edf-b1a033cd3848",
              "leftValue": "={{ $json.enrichmentOk === true && $json.commentCount >= 5 }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "869497d2-66e5-49a8-95cb-dd1205191db9",
      "name": "High activity digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        -200
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json;return [{json:{subject:'Morning brief | HIGH ACTIVITY',text:'Morning brief - '+d.generatedAt+'\\nTop five posts (highest ID, NOT a popularity ranking):\\n'+d.posts.map(p=>p.id+'. '+p.title).join('\\n')+'\\nTop post comment count: '+d.commentCount}}];"
      }
    },
    {
      "id": "6aeb8c12-00a6-40da-8c6a-41083a14f931",
      "name": "Standard or partial digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1200,
        0
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json;return [{json:{subject:d.enrichmentOk?'Morning brief | STANDARD':'Morning brief | PARTIAL DATA',text:'Morning brief - '+d.generatedAt+'\\n'+d.posts.map(p=>p.id+'. '+p.title).join('\\n')+'\\nTop post comments: '+d.commentCount+'\\n'+d.warning}}];"
      }
    },
    {
      "id": "004e7b11-84d5-4e18-a89a-457c329c3c11",
      "name": "Source failure digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        250
      ],
      "parameters": {
        "jsCode": "const d=$input.first().json;console.error('Morning brief source failure',JSON.stringify(d));return [{json:{subject:'Morning brief | SOURCE ERROR',text:'No digest available. '+d.error+' (status '+(d.statusCode??'network/schema error')+'). Check the n8n execution and rerun.'}}];"
      }
    },
    {
      "id": "6b2b1773-6c79-4376-b558-a99bc6479468",
